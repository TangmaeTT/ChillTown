{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2022"],
        "types": ["node"],
        "noEmit": true,
        "allowImportingTsExtensions": true,
        /* Node runs .ts by stripping types, so only erasable syntax (no enums, no parameter properties) */
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true,
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "skipLibCheck": true,
        "resolveJsonModule": true
    },
    "include": ["src", "../shared"]
}
